nsition hover:text-orange-700","children":"service status"}]," shows whether anything is wrong at our end."]}],["$","div",null,{"className":"mt-6 rounded-2xl border px-5 py-4 border-emerald-200 bg-emerald-50 text-emerald-950","children":[["$","p",null,{"className":"text-xs font-bold uppercase tracking-[0.2em] opacity-70","children":"Test it on a match night, not a quiet afternoon"}],["$","p",null,{"className":"text-sm leading-6 mt-2","children":"A free 24-hour trial tells you nothing useful at 11am on a Tuesday. Time it for a Saturday afternoon or a midweek European night, when the servers and your own broadband are both under real load."}]]}],["$","div",null,{"className":"mt-6 flex flex-wrap gap-3","children":[["$","$L4","Start a free 24-hour trial",{"href":"/iptv-uk-free-trial","className":"rounded-full bg-orange-500 px-6 py-3 text-sm font-semibold text-white transition hover:bg-orange-600","children":"Start a free 24-hour trial"}],["$","$L4","See the full channel list",{"href":"/channels","className":"rounded-full bg-orange-500 px-6 py-3 text-sm font-semibold text-white transition hover:bg-orange-600","children":"See the full channel list"}]]}]],["$","section",null,{"id":"faq","className":"mt-14 scroll-mt-24","children":[["$","h2",null,{"className":"text-3xl font-black tracking-tight text-slate-900 sm:text-4xl","children":"Frequently Asked Questions"}],["$","div",null,{"className":"mt-6 space-y-3","children":[["$","details","Does IPTV UK include Sky Sports?",{"className":"group rounded-2xl border border-slate-200 bg-slate-50 p-5","children":[["$","summary",null,{"className":"flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-semibold text-slate-900 sm:text-base","children":[["$","span",null,{"children":"Does IPTV UK include Sky Sports?"}],["$","span",null,{"className":"text-lg text-slate-400 transition group-open:rotate-45","children":"+"}]]}],["$","p",null,{"className":"mt-4 border-t border-slate-200 pt-4 text-sm leading-7 text-slate-600","children":"Yes — the complete Sky Sports line-up, including Main Event, Premier League, Football, Cricket, F1, Golf, Action, Arena, Sky Sports News, Racing, Mix and Sky Sports+. Main Event, Premier League and F1 are carried in 4K where Sky provides a 4K feed."}]]}],["$","details","Can I watch every Premier League match?",{"className":"group rounded-2xl border border-slate-200 bg-slate-50 p-5","children":[["$","summary",null,{"className":"flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-semibold text-slate-900 sm:text-base","children":[["$","span",null,{"children":"Can I watch every Premier League match?"}],["$","span",null,{"className":"text-lg text-slate-400 transition group-open:rotate-45","children":"+"}]]}],["$","p",null,{"className":"mt-4 border-t border-slate-200 pt-4 text-sm leading-7 text-slate-600","children":"You can watch the great majority of televised fixtures, because the line-up carries both Sky Sports and TNT Sports. But 267 of the 380 matches are broadcast live in the UK, and Saturday 3pm kick-offs are not shown domestically at all under the blackout rule. Any provider promising every match is describing something that does not exist in the UK."}]]}],["$","details","Is TNT Sports included?",{"className":"group rounded-2xl border border-slate-200 bg-slate-50 p-5","children":[["$","summary",null,{"className":"flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-semibold text-slate-900 sm:text-base","children":[["$","span",null,{"children":"Is TNT Sports included?"}],["$","span",null,{"className":"text-lg text-slate-400 transition group-open:rotate-45","children":"+"}]]}],["$","p",null,{"className":"mt-4 border-t border-slate-200 pt-4 text-sm leading-7 text-slate-600","children":"Yes, TNT Sports 1 to 4 plus TNT Sports Ultimate. That matters because TNT holds Champions League and Europa League football and Premiership rugby, none of which appear on Sky — a service carrying only one of the two packages leaves real gaps."}]]}],["$","details","Do I pay extra for pay-per-view boxing?",{"className":"group rounded-2xl border border-slate-200 bg-slate-50 p-5","children":[["$","summary",null,{"className":"flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-semibold text-slate-900 sm:text-base","children":[["$","span",null,{"children":"Do I pay extra for pay-per-view boxing?"}],["$","span",null,{"className":"text-lg text-slate-400 transition group-open:rotate-45","children":"+"}]]}],["$","p",null,{"className":"mt-4 border-t border-slate-200 pt-4 text-sm leading-7 text-slate-600","children":"No. Sky Sports Box Office events are included on every plan rather than billed per event, which is where the difference against a conventional package is most visible — a single PPV night can cost more than a month of most plans here."}]]}],["$","details","Can I watch sport in 4K?",{"className":"group rounded-2xl border border-slate-200 bg-slate-50 p-5","children":[["$","summary",null,{"className":"flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-semibold text-slate-900 sm:text-base","children":[["$","span",null,{"children":"Can I watch sport in 4K?"}],["$","span",null,{"className":"text-lg text-slate-400 transition group-open:rotate-45","children":"+"}]]}],["$","p",null,{"className":"mt-4 border-t border-slate-200 pt-4 text-sm leading-7 text-slate-600","children":"Yes, on the channels where the broadcaster provides a 4K feed — Sky Sports Main Event, Premier League and F1, and TNT Sports 1, 2 and Ultimate. You will want roughly 25 Mbps of steady broadband and a 4K television for it to be worth having."}]]}],["$","details","What about cricket and Formula 1?",{"className":"group rounded-2xl border border-slate-200 bg-slate-50 p-5","children":[["$","summary",null,{"className":"flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-semibold text-slate-900 sm:text-base","children":[["$","span",null,{"childr