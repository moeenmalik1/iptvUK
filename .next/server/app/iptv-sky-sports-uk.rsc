hildren":"Quality"}]]}]}],["$","tbody",null,{"children":[["$","tr","TNT Sports 1",{"className":"bg-white","children":[["$","td","TNT Sports 1-0",{"className":"border-t border-slate-200 px-4 py-3 align-top leading-6 font-semibold text-slate-900","children":"TNT Sports 1"}],["$","td","TNT Sports 1-1",{"className":"border-t border-slate-200 px-4 py-3 align-top leading-6 text-slate-600","children":"Champions League, Europa League, Premier League fixtures, Premiership rugby"}],["$","td","TNT Sports 1-2",{"className":"border-t border-slate-200 px-4 py-3 align-top leading-6 text-slate-600","children":"4K"}]]}],["$","tr","TNT Sports 2",{"className":"bg-slate-50","children":[["$","td","TNT Sports 2-0",{"className":"border-t border-slate-200 px-4 py-3 align-top leading-6 font-semibold text-slate-900","children":"TNT Sports 2"}],["$","td","TNT Sports 2-1",{"className":"border-t border-slate-200 px-4 py-3 align-top leading-6 text-slate-600","children":"Additional European football, rugby, UFC and MotoGP"}],["$","td","TNT Sports 2-2",{"className":"border-t border-slate-200 px-4 py-3 align-top leading-6 text-slate-600","children":"4K"}]]}],["$","tr","TNT Sports 3",{"className":"bg-white","children":[["$","td","TNT Sports 3-0",{"className":"border-t border-slate-200 px-4 py-3 align-top leading-6 font-semibold text-slate-900","children":"TNT Sports 3"}],["$","td","TNT Sports 3-1",{"className":"border-t border-slate-200 px-4 py-3 align-top leading-6 text-slate-600","children":"Overflow coverage when several matches clash"}],["$","td","TNT Sports 3-2",{"className":"border-t border-slate-200 px-4 py-3 align-top leading-6 text-slate-600","children":"HD"}]]}],["$","tr","TNT Sports 4",{"className":"bg-slate-50","children":[["$","td","TNT Sports 4-0",{"className":"border-t border-slate-200 px-4 py-3 align-top leading-6 font-semibold text-slate-900","children":"TNT Sports 4"}],["$","td","TNT Sports 4-1",{"className":"border-t border-slate-200 px-4 py-3 align-top leading-6 text-slate-600","children":"Further simultaneous fixtures and secondary events"}],["$","td","TNT Sports 4-2",{"className":"border-t border-slate-200 px-4 py-3 align-top leading-6 text-slate-600","children":"HD"}]]}],["$","tr","TNT Sports Ultimate",{"className":"bg-white","children":[["$","td","TNT Sports Ultimate-0",{"className":"border-t border-slate-200 px-4 py-3 align-top leading-6 font-semibold text-slate-900","children":"TNT Sports Ultimate"}],["$","td","TNT Sports Ultimate-1",{"className":"border-t border-slate-200 px-4 py-3 align-top leading-6 text-slate-600","children":"The 4K feed for marquee fixtures"}],["$","td","TNT Sports Ultimate-2",{"className":"border-t border-slate-200 px-4 py-3 align-top leading-6 text-slate-600","children":"4K"}]]}]]}]]}]}]]}],["$","p",null,{"className":"mt-4 text-base leading-7 text-slate-600 sm:text-[17px] sm:leading-8","children":["Beyond the two main packages, the line-up carries Premier Sports, LaLiga TV, Eurosport 1 and 2, Racing TV, MUTV, LFC TV, DAZN and Viaplay Sports. The full list is on the ",["$","$L4","1",{"href":"/channels","className":"font-semibold text-orange-600 underline decoration-orange-300 underline-offset-2 transition hover:text-orange-700","children":"IPTV UK channel list"}],", where you can search for a specific channel before you commit to anything."]}],["$","h2",null,{"id":"premier-league","className":"mt-12 scroll-mt-24 text-3xl font-black tracking-tight text-slate-900 sm:text-4xl","children":"Premier League Coverage, Honestly Described"}],["$","p",null,{"className":"mt-4 text-base leading-7 text-slate-600 sm:text-[17px] sm:leading-8","children":"This is where providers make claims that do not survive contact with the season, so it is worth being precise."}],["$","p",null,{"className":"mt-4 text-base leading-7 text-slate-600 sm:text-[17px] sm:leading-8","children":"Across a Premier League season, 267 of the 380 fixtures are broadcast live in the UK. Sky Sports carries the largest share, TNT Sports takes a smaller block, and Amazon has held a set of midweek fixtures. Because the line-up here carries both Sky and TNT, the great majority of televised matches are available."}],["$","div",null,{"className":"mt-6 rounded-2xl border px-5 py-4 border-amber-200 bg-amber-50 text-amber-950","children":[["$","p",null,{"className":"text-xs font-bold uppercase tracking-[0.2em] opacity-70","children":"The claim to be sceptical about"}],["$","p",null,{"className":"text-sm leading-6 mt-2","children":"Any provider advertising \"every Premier League match\" is describing something that does not exist in the UK. Saturday 3pm kick-offs are not broadcast domestically at all under the blackout rule — no legitimate service can show you a UK feed of a match that has no UK feed."}]]}],["$","p",null,{"className":"mt-4 text-base leading-7 text-slate-600 sm:text-[17px] sm:leading-8","children":"The 3pm fixtures are broadcast in other countries, and the international sports channels in the line-up carry some of those feeds. That is how most subscribers watch blacked-out matches, and it is a materially different thing from a UK broadcast — worth understanding before you buy rather than after."}],["$","h2",null,{"id":"other-sport","className":"mt-12 scroll-mt-24 text-3xl font-black tracking-tight text-slate-900 sm:text-4xl","children":"Beyond Football"}],["$","div",null,{"className":"mt-6 grid gap-4 sm:grid-cols-2","children":[["$","article","Cricket",{"className":"rounded-2xl border border-slate-200 bg-white p-5 shadow-[0_20px_60px_-45px_rgba(15,23,42,0.5)]","children":[["$","div",null,{"className":"flex items-start justify-between gap-3","children":[["$","h3",null,{"className":"text-base font-bold text-slate-900","children":"Cricket"}],null]}],["$","p",null,{"className":"mt-2 text-sm leading-6 text-slate-600","children":"England home Tests, ODIs and T20s on Sky Sports Cricket, plus The Hundred, county cricket and overseas tours. Winter Ashes tours run through the night and are exactly the kind of thing a subscription earns its keep on."}]]}],["$","article","Formula 1",{"className":"rounded-2xl border border-slate-200 bg-white p-5 shadow-[0_20px_60px_-45px_rgba(15,23,42,0.5)]","children":[["$","div",null,{"className":"flex items-start justify-between gap-3","children":[["$","h3",null,{"className":"text-base font-bold text-slate-900","children":"Formula 1"}],["$","span",null,{"className":"shrink-0 rounded-full bg-orange-50 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.14em] text-orange-600","children":"4K"}]]}],["$","p",null,{"className":"mt-2 text-sm leading-6 text-slate-600","children":"Sky Sports F1 carries every practice session, qualifying and race of the season, plus F2, F3 and the archive coverage between race weekends."}]]}],["$","article","Rugby",{"className":"rounded-2xl border border-slate-200 bg-white p-5 shadow-[0_20px_60px_-45px_rgba(15,23,42,0.5)]","children":[["$","div",null,{"className":"flex items-start justify-between gap-3","children":[["$","h3",null,{"className":"text-base font-bold text-slate-900","children":"Rugby"}],null]}],["$","p",null,{"className":"mt-2 text-sm leading-6 text-slate-600","children":"Premiership rugby on TNT Sports, Six Nations coverage across the free-to-air channels also in the line-up, and rugby league on Sky Sports Action."}]]}],["$","article","Boxing and PPV",{"className":"rounded-2xl border border-slate-200 bg-white p-5 shadow-[0_20px_60px_-45px_rgba(15,23,42,0.5)]","children":[["$","div",null,{"className":"flex items-start justify-between gap-3","children":[["$","h3",null,{"className":"text-base font-bold text-slate-900","children":"Boxing and PPV"}],["$","span",null,{"className":"shrink-0 rounded-full bg-orange-50 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.14em] text-orange-600","children":"No extra charge"}]]}],["$","p",null,{"className":"mt-2 text-sm leading-6 text-slate-600","children":"Sky Sports Box Office events are included rather than billed separately, which is where the cost difference against a conventional package becomes most obvious — a single PPV night can cost more than a month of most IPTV plans."}]]}],["$","article","Golf",{"className":"rounded-2xl border border-slate-200 bg-white p-5 shadow-[0_20px_60px_-45px_rgba(15,23,42,0.5)]","children":[["$","div",null,{"className":"flex items-start justify-between gap-3","children":[["$","h3",null,{"className":"text-base font-bold text-slate-900","children":"Golf"}],null]}],["$","p",null,{"className":"mt-2 text-sm leading-6 text-slate-600","children":"The Masters, The Open, the Ryder Cup and week-to-week PGA and DP World Tour coverage on Sky Sports Golf."}]]}],["$","article","Racing",{"className":"rounded-2xl border border-slate-200 bg-white p-5 shadow-[0_20px_60px_-45px_rgba(15,23,42,0.5)]","children":[["$","div",null,{"className":"flex items-start justify-between gap-3","children":[["$","h3",null,{"className":"text-base font-bold text-slate-900","children":"Racing"}],null]}],["$","p",null,{"className":"mt-2 text-sm leading-6 text-slate-600","children":"Sky Sports Racing and Racing TV between them cover UK and Irish meetings through the week, including the Cheltenham and Aintree festivals."}]]}]]}],["$","h2",null,{"id":"cost","className":"mt-12 scroll-mt-24 text-3xl font-black tracking-tight text-slate-900 sm:text-4xl","children":"What the Same Sport Costs Conventionally"}],["$","p",null,{"className":"mt-4 text-base leading-7 text-slate-600 sm:text-[17px] sm:leading-8","children":"The comparison that matters is not headline against headline, but what a household actually ends up paying once the sports channels, the second broadcaster and the pay-per-view nights are added up."}],["$","div",null,{"className":"mt-6","children":[null,["$","div",null,{"className":"overflow-x-auto rounded-2xl border border-slate-200 shadow-[0_20px_60px_-50px_rgba(15,23,42,0.6)]","children":["$","table",null,{"className":"w-full min-w-[640px] border-collapse text-left text-sm","children":[["$","thead",null,{"children":["$","tr",nu