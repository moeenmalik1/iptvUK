ildren":[["$","p",null,{"className":"text-sm font-bold text-slate-900 sm:text-base","children":"Plug in an Ethernet cable"}],["$","p",null,{"className":"text-sm leading-6 text-slate-600 mt-1","children":"The single most effective change for live sport, and it is permanent."}]]}]]}],["$","li","Clear the player cache and restart at the plug",{"className":"flex gap-4 rounded-2xl border border-slate-200 bg-slate-50 px-4 py-4 sm:px-5","children":[["$","span",null,{"className":"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-slate-900 text-xs font-bold text-white","children":3}],["$","div",null,{"children":[["$","p",null,{"className":"text-sm font-bold text-slate-900 sm:text-base","children":"Clear the player cache and restart at the plug"}],["$","p",null,{"className":"text-sm leading-6 text-slate-600 mt-1","children":"Fixes most gradual slowdowns on sticks and Smart TVs."}]]}]]}],["$","li","Move to 5 GHz and pause other downloads",{"className":"flex gap-4 rounded-2xl border border-slate-200 bg-slate-50 px-4 py-4 sm:px-5","children":[["$","span",null,{"className":"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-slate-900 text-xs font-bold text-white","children":4}],["$","div",null,{"children":[["$","p",null,{"className":"text-sm font-bold text-slate-900 sm:text-base","children":"Move to 5 GHz and pause other downloads"}],["$","p",null,{"className":"text-sm leading-6 text-slate-600 mt-1","children":"If a cable genuinely is not possible."}]]}]]}],["$","li","Change your DNS",{"className":"flex gap-4 rounded-2xl border border-slate-200 bg-slate-50 px-4 py-4 sm:px-5","children":[["$","span",null,{"className":"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-slate-900 text-xs font-bold text-white","children":5}],["$","div",null,{"children":[["$","p",null,{"className":"text-sm font-bold text-slate-900 sm:text-base","children":"Change your DNS"}],["$","p",null,{"className":"text-sm leading-6 text-slate-600 mt-1","children":"Free, two minutes, and it is the fix for DNS-level blocking."}]]}]]}],["$","li","Trial a VPN for one evening",{"className":"flex gap-4 rounded-2xl border border-slate-200 bg-slate-50 px-4 py-4 sm:px-5","children":[["$","span",null,{"className":"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-slate-900 text-xs font-bold text-white","children":6}],["$","div",null,{"children":[["$","p",null,{"className":"text-sm font-bold text-slate-900 sm:text-base","children":"Trial a VPN for one evening"}],["$","p",null,{"className":"text-sm leading-6 text-slate-600 mt-1","children":"Only if the mobile-data test pointed at your ISP."}]]}]]}],["$","li","Send us the channel name and time",{"className":"flex gap-4 rounded-2xl border border-slate-200 bg-slate-50 px-4 py-4 sm:px-5","children":[["$","span",null,{"className":"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-slate-900 text-xs font-bold text-white","children":7}],["$","div",null,{"children":[["$","p",null,{"className":"text-sm font-bold text-slate-900 sm:text-base","children":"Send us the channel name and time"}],["$","p",null,{"className":"text-sm leading-6 text-slate-600 mt-1","children":"Once you have ruled out everything on your side."}]]}]]}]]}],["$","div",null,{"className":"mt-6 rounded-2xl border px-5 py-4 border-emerald-200 bg-emerald-50 text-emerald-950","children":[["$","p",null,{"className":"text-xs font-bold uppercase tracking-[0.2em] opacity-70","children":"Test all of this during a free trial"}],["$","p",null,{"className":"text-sm leading-6 mt-2","children":"A 24-hour trial exists precisely so you can find out how a service behaves on your own broadband, on your own hardware, during a busy evening — before any money changes hands. Test it on a Saturday afternoon or a midweek match night rather than a quiet Tuesday morning."}]]}],["$","div",null,{"className":"mt-6 flex flex-wrap gap-3","children":[["$","$L4","Start a free 24-hour trial",{"href":"/iptv-uk-free-trial","className":"rounded-full bg-orange-500 px-6 py-3 text-sm font-semibold text-white transition hover:bg-orange-600","children":"Start a free 24-hour trial"}],["$","$L4","Check service status",{"href":"/status","className":"rounded-full bg-orange-500 px-6 py-3 text-sm font-semibold text-white transition hover:bg-orange-600","children":"Check service status"}]]}]],["$","section",null,{"id":"faq","className":"mt-14 scroll-mt-24","children":[["$","h2",null,{"className":"text-3xl font-black tracking-tight text-slate-900 sm:text-4xl","children":"Frequently Asked Questions"}],["$","div",null,{"className":"mt-6 space-y-3","children":[["$","details","Why does my IPTV keep buffering in the evening?",{"className":"group rounded-2xl border border-slate-200 bg-slate-50 p-5","children":[["$","summary",null,{"className":"flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-semibold text-slate-900 sm:text-base","children":[["$","span",null,{"children":"Why does my IPTV keep buffering in the evening?"}],["$","span",null,{"className":"text-lg text-slate-400 transition group-open:rotate-45","children":"+"}]]}],["$","p",null,{"className":"mt-4 border-t border-slate-200 pt-4 text-sm leading-7 text-slate-600","children":"Evening buffering that clears overnight is nearly always congestion or ISP traffic shaping rather than the service itself. Test the same channel on mobile data during a bad spell: if it plays cleanly there, the problem is your broadband connection or your ISP, and a wired connection followed by a DNS change are the two fixes worth trying first."}]]}],["$","details","Will a VPN stop IPTV buffering?",{"className":"group rounded-2xl border border-slate-200 bg-slate-50 p-5","children":[["$","summary",null,{"className":"flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-semibold text-slate-900 sm:text-base","children":[["$","span",null,{"children":"Will a VPN stop IPTV buffering?"}],["$","span",null,{"className":"text-lg text-slate-400 transition group-open:rotate-45","children":"+"}]]}],["$","p",null,{"className":"mt-4 border-t border-slate-200 pt-4 text-sm leading-7 text-slate-600","children":"Only if your ISP is shaping or blocking the traffic. A VPN hides what you are streaming, so it defeats throttling — but it cannot create bandwidth, so it does nothing for weak Wi-Fi, a slow device or genuine congestion, and a free VPN will usually make things worse. Trial one for a single evening and judge it immediately."}]]}],["$","details","Is my ISP blocking IPTV?",{"className":"group rounded-2xl border border-slate-200 bg-slate-50 p-5","children":[["$","summary",null,{"className":"flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-semibold text-slate-900 sm:text-base","children":[["$","span",null,{"children":"Is my ISP blocking IPTV?"}],["$","span",null,{"className":"text-lg text-slate-400 transition group-open:rotate-45","children":"+"}]]}],["$","p",null,{"className":"mt-4 border-t border-slate-200 pt-4 text-sm leading-7 text-slate-600","children":"It is possible. UK ISPs including BT, Sky, Virgin Media and TalkTalk have come under growing pressure to restrict streaming traffic. The signature is a speed test that reports your full line rate while the stream still stutters, or a player that cannot connect at all. Changing to a public DNS resolver is the first thing to try, because it is free and takes two minutes."}]]}],["$","details","How much broadband speed do I need for IPTV?",{"className":"group rounded-2xl border border-slate-200 bg-slate-50 p-5","children":[["$","summary",null,{"className":"flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-semibold text-slate-900 sm:text-base","children":[["$","span",null,{"children":"How much broadband speed do I need for IPTV?"}],["$","span",null,{"className":"text-lg text-slate-400 transition group-open:rotate-45","children":"+"}]]}],["$","p",null,{"className":"mt-4 border-t border-slate-200 pt-4 text-sm leading-7 text-slate-600","children":"Roughly 5 Mbps for standard definition, 10 Mbps for HD and 25 Mbps for 4K — per stream, so two televisions watching at once need both. Steadiness matters more than the headline number: a stable 20 Mbps connection outperforms a 200 Mbps one that drops every few minutes."}]]}],["$","details","Why does only one channel buffer?",{"className":"group rounded-2xl border border-slate-200 bg-slate-50 p-5","children":[["$","summary",null,{"className":"flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-semibold text-slate-900 sm:text-base","children":[["$","span",null,{"children":"Why does only one channel buffer?"}],["$","span",null,{"className":"text-lg text-slate-400 transition group-open:rotate-45","children":"+"}]]}],["$","p",null,{"className":"mt-4 border-t border-slate-200 pt-4 text-sm leading-7 text-slate-600","children":"That is the source feed rather than anything at your end, and no change to your network or device will fix it. Send us the channel name and we will get it restored."}]]}],["$","details","Does Ethernet really make that much difference?",{"className":"group rounded-2xl border border-slate-200 bg-slate-50 p-5","children":[["$","summary",null,{"className":"flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-semibold text-slate-900 sm:text-base","children":[["$","span",null,{"children":"Does Ethernet really make that much difference?"}],["$","span",null,{"className":"text-lg text-slate-400 transition group-open:rotate-45","children":"+"}]]}],["$","p",null,{"className":"mt-4 border-t border-slate-200 pt-4 text-sm leading-7 text-slate-600","children":"Yes — it is consistently the single most effective change. Televisions have weaker aerials than the phone sitting next to them, and Wi-Fi contends with walls, neighbours and every other device in the house. A cable removes all of that at once, and for live sport it is the difference most people notice immediately."}]]}],["$","details","My IPTV worked fine and suddenly started buffering. What changed?",{"className":"group rounded-2xl border border-slate-200 bg-slate-50 p-5","children":[["$","summary",null,{"className":"flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-semibold text-slate-900 sm:text-base","children":[["$","span",null,{"children":"My IPTV worked fine and suddenly started buffering. What changed?"}],["$","span",null,{"className":"text-lg text-slate-400 transition group-open:rotate-45","children":"+"}]]}],["$","p",null,{"className":"mt-4 border-t border-slate-200 pt-4 text-sm leading-7 text-slate-600","children":"The usual culprits are a full device, an accumulated programme guide cache, a system update that reset network settings, or a new device on your home network competing for bandwidth. Clear the player cache, restart at the plug rather than standby, and check what else has joined the Wi-Fi recently."}]]}],["$","details","Should I switch provider if it keeps buffering?",{"className":"group rounded-2xl border border-slate-200 bg-slate-50 p-5","children":[["$","summary",null,{"className":"flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-semibold text-slate-900 sm:text-base","children":[["$","span",null,{"children":"Should I switch provider if it keeps buffering?"}],["$","span",null,{"className":"text-lg text-slate-400 transition group-open:rotate-45","children":"+"}]]}],["$","p",null,{"className":"mt-4 border-t border-slate-200 pt-4 text-sm leading-7 text-slate-600","children":"Not before you have run the mobile-data test. If the stream buffers on mobile data as well as broadband, changing provider might help. If it plays cleanly on mobile data, the problem is on your side of the front door and a new subscription will behave exactly the same way."}]]}]]}]]}],["$","section",null,{"className":"mt-14 overflow-hidden rounded-[2rem] bg-gradient-to-br from-slate-950 via-slate-900 to-slate-800 p-7 text-white shadow-[0_