nter rounded-full bg-slate-900 text-xs font-bold text-white","children":2}],["$","h3",null,{"className":"mt-4 text-base font-bold text-slate-900","children":"Video plays but there is no sound"}],["$","p",null,{"className":"mt-2 text-sm leading-7 text-slate-600","children":"Windows often sends audio to the wrong output after an HDMI cable is plugged in. Check the volume mixer and the player's own audio track selector, since some channels carry more than one audio track."}]]}],["$","article","The playlist will not load at all",{"className":"rounded-[1.5rem] border border-slate-200 bg-white p-6","children":[["$","span",null,{"className":"inline-flex h-8 w-8 items-center justify-center rounded-full bg-slate-900 text-xs font-bold text-white","children":3}],["$","h3",null,{"className":"mt-4 text-base font-bold text-slate-900","children":"The playlist will not load at all"}],["$","p",null,{"className":"mt-2 text-sm leading-7 text-slate-600","children":"Paste the link into a browser address bar. If it downloads a file, your details are fine and the player is the problem. If it errors, re-check the URL for a missing character or an expired subscription."}]]}],["$","article","Everything buffers on Wi-Fi",{"className":"rounded-[1.5rem] border border-slate-200 bg-white p-6","children":[["$","span",null,{"className":"inline-flex h-8 w-8 items-center justify-center rounded-full bg-slate-900 text-xs font-bold text-white","children":4}],["$","h3",null,{"className":"mt-4 text-base font-bold text-slate-900","children":"Everything buffers on Wi-Fi"}],["$","p",null,{"className":"mt-2 text-sm leading-7 text-slate-600","children":"Laptops often sit on a congested 2.4 GHz band. Switch to the 5 GHz network, or plug in an Ethernet cable. This fixes far more buffering complaints than any player setting."}]]}],["$","article","A VPN or work laptop blocks it",{"className":"rounded-[1.5rem] border border-slate-200 bg-white p-6","children":[["$","span",null,{"className":"inline-flex h-8 w-8 items-center justify-center rounded-full bg-slate-900 text-xs font-bold text-white","children":5}],["$","h3",null,{"className":"mt-4 text-base font-bold text-slate-900","children":"A VPN or work laptop blocks it"}],["$","p",null,{"className":"mt-2 text-sm leading-7 text-slate-600","children":"Corporate laptops, school networks, and some VPNs block the ports streaming uses. Try the same details on a personal device on home broadband before assuming the service is at fault."}]]}],["$","article","The picture is fine but the guide is empty",{"className":"rounded-[1.5rem] border border-slate-200 bg-white p-6","children":[["$","span",null,{"className":"inline-flex h-8 w-8 items-center justify-center rounded-full bg-slate-900 text-xs font-bold text-white","children":6}],["$","h3",null,{"className":"mt-4 text-base font-bold text-slate-900","children":"The picture is fine but the guide is empty"}],["$","p",null,{"className":"mt-2 text-sm leading-7 text-slate-600","children":"Programme data loads separately from the channels and can take longer. Give it a few minutes, then refresh the EPG from the player settings. Message us if it stays blank."}]]}]]}]]}]}],["$","section",null,{"id":"faq","className":"scroll-mt-24 bg-white py-14 sm:py-20","children":["$","div",null,{"className":"mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8","children":[["$","h2",null,{"className":"text-3xl font-black tracking-tight text-slate-900 sm:text-4xl","children":"IPTV on PC: frequently asked questions"}],["$","div",null,{"className":"mt-8 space-y-3","children":[["$","details","Can I watch IPTV on a Windows PC?",{"className":"group rounded-2xl border border-slate-200 bg-slate-50 p-5","children":[["$","summary",null,{"className":"flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-semibold text-slate-900 sm:text-base","children":[["$","span",null,{"children":"Can I watch IPTV on a Windows PC?"}],["$","span",null,{"className":"text-lg text-slate-400 transition group-open:rotate-45","children":"+"}]]}],["$","p",null,{"className":"mt-4 border-t border-slate-200 pt-4 text-sm leading-7 text-slate-600","children":"Yes. Windows 10 and 11 both work. Install IPTV Smarters Expert from the Microsoft Store for a television-style interface, or use VLC if you just want something that plays your channel list without any setup. Both are free to download."}]]}],["$","details","Does IPTV work on a Mac?",{"className":"group rounded-2xl border border-slate-200 bg-slate-50 p-5","children":[["$","summary",null,{"className":"flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-semibold text-slate-900 sm:text-base","children":[["$","span",null,{"children":"Does IPTV work on a Mac?"}],["$","span",null,{"className":"text-lg text-slate-400 transition group-open:rotate-45","children":"+"}]]}],["$","p",null,{"className":"mt-4 border-t border-slate-200 pt-4 text-sm leading-7 text-slate-600","children":"Yes, though the players differ. IINA and VLC both run natively on Apple Silicon and Intel Macs and open M3U playlists. Our IPTV for Mac page covers macOS setup, AirPlay to an Apple TV and the Gatekeeper prompt you will see on first launch."}]]}],["$","details","Can I use VLC for IPTV?",{"className":"group rounded-2xl border border-slate-200 bg-slate-50 p-5","children":[["$","summary",null,{"className":"flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-semibold text-slate-900 sm:text-base","children":[["$","span",null,{"children":"Can I use VLC for IPTV?"}],["$","span",null,{"className":"text-lg text-slate-400 transition group-open:rotate-45","children":"+"}]]}],["$","p",null,{"className":"mt-4 border-t border-slate-200 pt-4 text-sm leading-7 text-slate-600","children":"Yes, and it is often the best place to start. Go to Media → Open Network Stream, paste your M3U link, and the channel list loads. VLC has no programme guide or category menus, but it is the most reliable way to confirm your subscription works before setting