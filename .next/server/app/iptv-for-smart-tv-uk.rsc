:"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-orange-500 text-xs font-bold text-white","children":3}],["$","div",null,{"children":[["$","p",null,{"className":"text-sm font-bold text-slate-900 sm:text-base","children":"Send us the MAC address"}],["$","p",null,{"className":"mt-1 text-sm leading-7 text-slate-600","children":"Send the MAC address and device key to us on WhatsApp. We load your playlist onto that device from our end. This is why Smart TV setup is quicker than it sounds — there is nothing to type on the television."}]]}]]}],["$","li","Restart the app",{"className":"flex gap-4 rounded-2xl border border-slate-200 bg-white px-4 py-4 sm:px-5","children":[["$","span",null,{"className":"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-orange-500 text-xs font-bold text-white","children":4}],["$","div",null,{"children":[["$","p",null,{"className":"text-sm font-bold text-slate-900 sm:text-base","children":"Restart the app"}],["$","p",null,{"className":"mt-1 text-sm leading-7 text-slate-600","children":"Once we confirm, close the player completely and reopen it. Your channels, categories and programme guide import automatically. Give the guide a few minutes to finish loading the first time."}]]}]]}],["$","li","Test before you commit",{"className":"flex gap-4 rounded-2xl border border-slate-200 bg-white px-4 py-4 sm:px-5","children":[["$","span",null,{"className":"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-orange-500 text-xs font-bold text-white","children":5}],["$","div",null,{"children":[["$","p",null,{"className":"text-sm font-bold text-slate-900 sm:text-base","children":"Test before you commit"}],["$","p",null,{"className":"mt-1 text-sm leading-7 text-slate-600","children":"Play a live channel, then something on demand. Check that the guide matches what is actually on and that channel switching feels quick. Tell us about anything odd while the trial is still running."}]]}]]}]]}],["$","p",null,{"classNa